{
  "name": "hyperclick-pro",
  "version": "1.2.0",
  "description": "HyperClick Pro - Next-Generation Ultra-Fast 2026 UI/UX Auto-Clicker & Automation Suite",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "generate:icons": "node scripts/generate-icons.js",
    "build:all": "node scripts/build-all.js",
    "dist": "npm run generate:icons && npm run build && npm run build:electron && electron-builder --win",
    "dist:portable": "npm run generate:icons && npm run build && npm run build:electron && electron-builder --win portable",
    "dist:dir": "npm run generate:icons && npm run build && npm run build:electron && electron-builder --win --dir",
    "pack": "electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "autoclicker",
    "auto-clicker",
    "macro",
    "automation",
    "ultra-fast",
    "humanizer",
    "cps",
    "gamer-tools"
  ],
  "author": "HyperClick Engineering",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "happy-dom": "^20.11.2",
    "postcss": "^8.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.hyperclick.pro",
    "productName": "HyperClick Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "HyperClick Pro",
      "runAfterFinish": true,
      "installerLanguages": [
        "en_US",
        "de_DE",
        "fr_FR",
        "es_ES"
      ],
      "deleteAppDataOnUninstall": false,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "installer/installerHeaderIcon.ico",
      "include": "installer/installer.nsh"
    },
    "portable": {
      "splashImage": "public/icon-256.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Laknicek",
        "repo": "hyperclick-pro"
      }
    ]
  }
}
